[Unit]
Description=Back up Tuci account and vocabulary database
After=tuci-sync.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/tuci-backup
UMask=0077
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/tuci-sync /var/lib/tuci-sync
PrivateTmp=yes
NoNewPrivileges=yes
