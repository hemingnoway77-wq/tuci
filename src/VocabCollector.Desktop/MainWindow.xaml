<Window x:Class="VocabCollector.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:preview="clr-namespace:VocabCollector.Desktop.Preview" xmlns:local="clr-namespace:VocabCollector.Desktop" xmlns:controls="clr-namespace:VocabCollector.Desktop.Controls"
 Title="兔词" Width="1220" Height="840" MinWidth="920" MinHeight="700" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
 <Grid x:Name="WindowLayout" Background="Transparent" Focusable="True" KeyboardNavigation.IsTabStop="False" FocusVisualStyle="{x:Null}" local:BlankAreaFocus.IsEnabled="True">
  <Grid.RowDefinitions><RowDefinition Height="100" /><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions>

  <Border x:Name="MainHeader" Grid.Row="0" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="34,0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="42"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
     <Image Source="Assets/app-icon-256.png" Width="32" Height="32" Margin="0,0,11,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="兔词" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
      <TextBlock Text="VOCABULARY NOTES" FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{DynamicResource InkTertiary}" Margin="0,1,0,0" />
     </StackPanel>
    </StackPanel>
    <Grid x:Name="MainNavigation" Grid.Row="1" Grid.ColumnSpan="3" SizeChanged="Navigation_SizeChanged">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
     <RadioButton x:Name="CaptureTab" GroupName="Pages" Style="{StaticResource NavTab}" Content="收录" MinWidth="56" Margin="0,0,28,0" IsChecked="True" Checked="CaptureTab_Checked" AutomationProperties.Name="收录" />
     <RadioButton x:Name="LibraryTab" GroupName="Pages" Style="{StaticResource NavTab}" Content="词库" MinWidth="56" Margin="0,0,28,0" Checked="LibraryTab_Checked" AutomationProperties.Name="词库" />
     <RadioButton x:Name="RoamingTab" GroupName="Pages" Style="{StaticResource NavTab}" Content="漫游" MinWidth="56" Margin="0,0,28,0" Checked="RoamingTab_Checked" AutomationProperties.Name="漫游" />
     <RadioButton x:Name="ReadingTab" GroupName="Pages" Style="{StaticResource NavTab}" Content="每日阅读" MinWidth="78" Checked="ReadingTab_Checked" AutomationProperties.Name="每日阅读" />
    </StackPanel>
    <controls:PageTabIndicator x:Name="PageUnderline" VerticalAlignment="Bottom"/>
    </Grid>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
      <TextBlock Text="主题" Style="{StaticResource MetaText}" VerticalAlignment="Center" Margin="0,0,10,0" />
      <RadioButton x:Name="ThemeMonoOption" GroupName="Theme" Style="{StaticResource ThemeSwatch}" Tag="Mono" Checked="ThemeOption_Checked" AutomationProperties.Name="墨白主题" ToolTip="墨白 · 纯黑白灰">
       <RadioButton.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
         <GradientStop Color="#232321" Offset="0" />
         <GradientStop Color="#232321" Offset="0.5" />
         <GradientStop Color="#DDDDD8" Offset="0.5" />
         <GradientStop Color="#DDDDD8" Offset="1" />
        </LinearGradientBrush>
       </RadioButton.Background>
      </RadioButton>
      <RadioButton x:Name="ThemeWarmOption" GroupName="Theme" Style="{StaticResource ThemeSwatch}" Tag="WarmNeutral" Background="#B58A6C" Checked="ThemeOption_Checked" AutomationProperties.Name="暖灰主题" ToolTip="暖灰 · 纸页米色" />
      <RadioButton x:Name="ThemeRoseOption" GroupName="Theme" Style="{StaticResource ThemeSwatch}" Tag="Pink" Background="#B8607A" Checked="ThemeOption_Checked" AutomationProperties.Name="玫红主题" ToolTip="玫红 · 浅粉纸面" />
     </StackPanel>
     <Border Width="1" Background="{DynamicResource Line}" Margin="0,15,14,15" />
     <Button x:Name="RefreshLinksButton" Style="{StaticResource UtilityButton}" Command="{Binding RefreshLinksCommand}" ToolTip="本地刷新单词与词根的关联，不调用 AI">
      <StackPanel Orientation="Horizontal">
       <Path Data="M 13,4 A 5.4,5.4 0 1 0 13,11 M 10,4 L 13,4 L 13,1" Stroke="{DynamicResource Accent}" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
       <TextBlock Text="刷新关联" />
      </StackPanel>
     </Button>
     <Button x:Name="SyncButton" Content="词库同步" Style="{StaticResource UtilityButton}" Click="Sync_Click" Margin="6,0,0,0" />
     <Button x:Name="SettingsButton" Style="{StaticResource UtilityOutline}" Click="Settings_Click" IsEnabled="{Binding CanConfigure}" Margin="7,0,0,0" ToolTip="API 与词库设置">
      <StackPanel Orientation="Horizontal">
       <Path Data="M 2,4.5 L 14,4.5 M 2,11.5 L 14,11.5 M 6,2 L 6,7 M 10,9 L 10,14" Stroke="{DynamicResource Accent}" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
       <TextBlock Text="设置" />
      </StackPanel>
     </Button>
    </StackPanel>
   </Grid>
  </Border>

  <Grid x:Name="PageHost" Grid.Row="1">
   <Grid x:Name="CapturePage" Margin="22,18,22,16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="358" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource SheetCard}" Padding="28,26,28,22">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <ScrollViewer x:Name="InputScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding CanConfigure}">
       <StackPanel Margin="0,0,3,0">
        <TextBlock Style="{StaticResource Eyebrow}" Text="NEW ENTRY" />
        <TextBlock Style="{StaticResource PageTitle}" Text="收录新词" Margin="0,8,0,0" />
        <Border Width="34" Height="1" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="0,11,0,24" />
        <Grid Margin="0,0,0,6">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <TextBlock Style="{StaticResource FieldLabel}" Text="英文单词" />
         <TextBlock Grid.Column="1" Style="{StaticResource MetaText}" Text="最多 64 个字符" VerticalAlignment="Bottom" />
        </Grid>
        <TextBox x:Name="WordBox" Style="{StaticResource WordInput}" Text="{Binding Word,UpdateSourceTrigger=PropertyChanged}" Tag="serendipity" ToolTip="输入一个英文单词，最多 64 个字符" />
        <Border Height="24" />
        <Grid Margin="0,0,0,6">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <TextBlock Style="{StaticResource FieldLabel}" Text="遇见它的原句" />
         <TextBlock Grid.Column="1" Style="{StaticResource MetaText}" Text="可选" VerticalAlignment="Bottom" />
        </Grid>
        <TextBox x:Name="ContextBox" Style="{StaticResource ContextInput}" Text="{Binding Context,UpdateSourceTrigger=PropertyChanged}" Tag="粘贴原句，理解它在这里的意思…" />
        <TextBlock Style="{StaticResource HintText}" Text="一句真实的语境，让释义更贴近你的阅读。" Margin="0,9,0,0" />
       </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="1" Margin="0,18,0,0">
       <Button x:Name="GenerateButton" Style="{StaticResource PrimaryAction}" Command="{Binding GenerateCommand}" Height="44">
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="解析并保存" />
         <Path Data="M 1,7 L 13,7 M 8,2 L 13,7 L 8,12" Stroke="{DynamicResource AccentInk}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
       </Button>
       <Button x:Name="CancelButton" Content="取消本次操作" Command="{Binding CancelCommand}" Style="{StaticResource QuietAction}" Margin="0,5,0,0" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" />
       <TextBlock Style="{StaticResource MetaCenter}" Text="自动纠错 · 收进本地词库" Margin="0,10,0,0" />
      </StackPanel>
     </Grid>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource SheetCard}" Padding="0">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Width="1" HorizontalAlignment="Left" Margin="52,0,0,0" Background="{DynamicResource Margin}" Opacity="0.55" />
      <Grid Grid.Column="1" Margin="0,26,38,18">
       <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <Grid>
        <StackPanel>
         <TextBlock Style="{StaticResource Eyebrow}" Text="NOTE PREVIEW" />
         <TextBlock Style="{StaticResource PageTitle}" Text="笔记预览" Margin="0,8,0,0" />
        </StackPanel>
        <TextBlock Style="{StaticResource MetaText}" Text="只读" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
       </Grid>
       <Grid Grid.Row="1" Margin="0,24,0,0">
        <preview:MarkdownPreview x:Name="NotePreview" Markdown="{Binding Markdown}" LinkRequested="Preview_LinkRequested" Background="Transparent" BorderThickness="0" Padding="0" />
        <StackPanel x:Name="PreviewEmptyState" Margin="0,42,0,0" VerticalAlignment="Top">
         <StackPanel.Style>
          <Style TargetType="StackPanel">
           <Setter Property="Visibility" Value="Collapsed" />
           <Style.Triggers><DataTrigger Binding="{Binding Markdown}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
          </Style>
         </StackPanel.Style>
         <TextBlock>
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="Text" Value="还没有词卡" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Style.Triggers>
             <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Text" Value="正在整理这次遇见…" /></DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
         <TextBlock Text="输入一个单词和它出现的句子，点击「解析并保存」。" Style="{StaticResource BodyText}" Margin="0,10,0,0" MaxWidth="480" HorizontalAlignment="Left" />
         <TextBlock Text="生成的词卡会以完整的阅读排版出现在这里。" Style="{StaticResource HintText}" Margin="0,6,0,0" />
         <Border Width="34" Height="1" Background="{DynamicResource Line}" HorizontalAlignment="Left" Margin="0,20,0,0" />
        </StackPanel>
       </Grid>
       <StackPanel Grid.Row="2" Margin="0,10,0,0">
        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Notes.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,0,0,9" />
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Style="{StaticResource MetaText}" Text="词卡位置" />
          <TextBlock x:Name="NotePathText" Text="{Binding SelectedNote.VaultRelativePath}" FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{DynamicResource InkSecondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
          <ListBox x:Name="NotesList" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" DisplayMemberPath="VaultRelativePath" MaxHeight="40" Margin="0,4,0,0">
           <ListBox.Style>
            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
             <Style.Triggers>
              <DataTrigger Binding="{Binding Notes.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
              <DataTrigger Binding="{Binding Notes.Count}" Value="1"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
             </Style.Triggers>
            </Style>
           </ListBox.Style>
          </ListBox>
         </StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="OpenNoteButton" Content="在词库中阅读" Click="OpenNote_Click" IsEnabled="{Binding CanOpen}" Style="{StaticResource OutlineAction}" />
          <Button x:Name="OpenFolderButton" Content="打开文件夹" Click="OpenFolder_Click" IsEnabled="{Binding CanOpen}" Style="{StaticResource QuietAction}" Margin="6,0,0,0" />
         </StackPanel>
        </Grid>
       </StackPanel>
      </Grid>
     </Grid>
    </Border>
   </Grid>
  </Grid>

  <Border x:Name="PreparationOverlay" Grid.Row="1" Panel.ZIndex="10" Background="{DynamicResource ShellBackground}" Visibility="Collapsed">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="正在准备…" Style="{StaticResource HintText}" HorizontalAlignment="Center"/>
    <ProgressBar x:Name="PreparationProgress" Width="96" Height="2" Margin="0,14,0,0" IsIndeterminate="False"/>
   </StackPanel>
  </Border>
  <Border x:Name="MainFooter" Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="34,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,9,0" />
     <TextBlock x:Name="StatusMessageText" Style="{StaticResource StatusText}" />
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0">
     <ProgressBar x:Name="StatusProgress" Width="46" Height="2" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,14,0" />
     <TextBlock x:Name="StatusMetaText" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
