<Window x:Class="VocabCollector.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="单词收集器" Width="1100" Height="760" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24">
      <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="设置" Click="Settings_Click" IsEnabled="{Binding CanConfigure}" VerticalAlignment="Center" />
      <StackPanel><TextBlock Text="单词收集器" FontSize="26" FontWeight="Bold" /><TextBlock Text="把遇见的单词，留在自己的词库里。" Foreground="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="12" Padding="22">
        <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel IsEnabled="{Binding CanConfigure}">
            <TextBlock Text="遇见一个新单词" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,24" />
            <TextBlock Text="英文单词" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="WordBox" Text="{Binding Word,UpdateSourceTrigger=PropertyChanged}" FontSize="20" ToolTip="单个英文单词，最多 64 个字符" />
            <TextBlock Text="原句（可选）" Style="{StaticResource FieldLabel}" Margin="0,24,0,7" />
            <TextBox x:Name="ContextBox" Text="{Binding Context,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="140" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
            <TextBlock Text="粘贴遇见它的那句话，帮助 AI 判断这里的词义和词性。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <Button x:Name="GenerateButton" Content="解析并保存" Style="{StaticResource PrimaryButton}" Command="{Binding GenerateCommand}" Padding="18,13" />
            <Button x:Name="CancelButton" Content="取消本次解析" Command="{Binding CancelCommand}" Background="Transparent" Margin="0,8,0,0" />
            <TextBlock Text="已有笔记会保留，重复单词不会覆盖。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="22">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14"><TextBlock Text="单词笔记" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="MARKDOWN" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel>
          <TextBox x:Name="MarkdownBox" Grid.Row="1" Text="{Binding Markdown,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="13" Background="#FAFBFE" BorderBrush="#E8EDF5" VerticalContentAlignment="Top" />
          <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="保存位置 / 已有词条" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
            <ListBox x:Name="NotesList" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" DisplayMemberPath="VaultRelativePath" Height="50" BorderBrush="#E8EDF5" FontSize="12" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="OpenNoteButton" Content="在 Obsidian 中打开" Click="OpenNote_Click" IsEnabled="{Binding CanOpen}" Padding="12,8" />
              <Button x:Name="OpenFolderButton" Content="打开文件夹" Click="OpenFolder_Click" IsEnabled="{Binding CanOpen}" Padding="12,8" Margin="8,0,0,0" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="#E8EDF5" CornerRadius="8" Margin="0,18,0,0" Padding="14,10"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" /></Border>
  </Grid>
</Window>
