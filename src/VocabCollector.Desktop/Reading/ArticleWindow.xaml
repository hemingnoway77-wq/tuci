<Window x:Class="VocabCollector.Desktop.Reading.ArticleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="来源文章 · 兔词" Width="1080" Height="780" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closed="Window_Closed">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="4"/><RowDefinition Height="*"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <WrapPanel DockPanel.Dock="Right" Margin="16,0,0,0">
    <Button x:Name="BackButton" Content="后退" IsEnabled="False" Click="Back_Click" Style="{DynamicResource OutlineAction}" Margin="0,0,6,0"/>
    <Button x:Name="ForwardButton" Content="前进" IsEnabled="False" Click="Forward_Click" Style="{DynamicResource OutlineAction}" Margin="0,0,6,0"/>
    <Button x:Name="ReloadButton" Content="重新加载" IsEnabled="False" Click="Reload_Click" Style="{DynamicResource OutlineAction}"/>
   </WrapPanel>
   <TextBlock x:Name="ArticleTitle" Text="来源文章" Style="{DynamicResource PageTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
  </DockPanel>
  <TextBox x:Name="AddressBox" Grid.Row="1" IsReadOnly="True" AutomationProperties.Name="来源文章地址" Margin="0,0,0,8"/>
  <DockPanel Grid.Row="2" Margin="0,0,0,10">
   <Button x:Name="RetryButton" DockPanel.Dock="Right" Content="重试" Click="Retry_Click" Visibility="Collapsed" Style="{DynamicResource OutlineAction}" Margin="12,0,0,0"/>
   <TextBlock x:Name="StatusText" Text="显示窗口后开始加载来源文章。" Style="{DynamicResource HintText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
  </DockPanel>
  <ProgressBar x:Name="LoadingProgress" Grid.Row="3" IsIndeterminate="True" Visibility="Collapsed"/>
  <Grid Grid.Row="4" Margin="0,10,0,0">
   <Grid x:Name="BrowserHost"/>
   <Border x:Name="MessagePanel" Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="32">
    <TextBlock x:Name="MessageText" Text="来源文章将在这里打开。" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="580" Style="{DynamicResource BodyText}"/>
   </Border>
  </Grid>
 </Grid>
</Window>
