<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>兔词</AssemblyName>
    <RootNamespace>VocabCollector.Desktop</RootNamespace>
    <PackageId>VocabCollector</PackageId>
    <AssemblyTitle>兔词</AssemblyTitle>
    <Product>兔词</Product>
    <Description>收录英文单词，在应用内阅读笔记与漫游复习。</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../VocabCollector.Core/VocabCollector.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup><Resource Include="Assets\app.ico" /><Resource Include="Assets\app-icon-256.png" /></ItemGroup>
  <ItemGroup><Resource Include="Learning\Effects\InkDistortion.ps" /></ItemGroup>
  <ItemGroup>
    <Content Include="Assets\OfflineTranslation\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Assets\OfflineDictionary\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.md" LogicalName="VocabCollector.ThirdPartyNotices" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
