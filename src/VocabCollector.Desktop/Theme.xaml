<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VocabCollector.Desktop">
 <!-- Safe neutral defaults for standalone resource consumers; ThemeManager supplies the live palette. -->
 <SolidColorBrush x:Key="Ink" Color="#35312D" /><SolidColorBrush x:Key="Muted" Color="#756C62" />
 <SolidColorBrush x:Key="Rose" Color="#6B5140" /><SolidColorBrush x:Key="RoseSoft" Color="#EFE7DC" />
 <SolidColorBrush x:Key="Line" Color="#DDD4C8" /><SolidColorBrush x:Key="Paper" Color="#FFFCF7" />
 <BooleanToVisibilityConverter x:Key="BoolVisibility" />
 <LinearGradientBrush x:Key="ShellBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource ThemeColorFFE3ED}" Offset="0" /><GradientStop Color="{DynamicResource ThemeColorFFF3F2}" Offset="0.5" /><GradientStop Color="{DynamicResource ThemeColorFBE6EE}" Offset="1" /></LinearGradientBrush>
 <Style TargetType="Window">
  <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource Ink}" />
  <Setter Property="Background" Value="{DynamicResource ShellBackground}" /><Setter Property="Icon" Value="Assets/app.ico" />
  <Setter Property="UseLayoutRounding" Value="True" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" />
 </Style>
 <Style x:Key="SurfaceCard" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource Paper}" /><Setter Property="BorderBrush" Value="{DynamicResource ThemeBrushFFF8FB}" /><Setter Property="BorderThickness" Value="1" />
  <Setter Property="CornerRadius" Value="22" /><Setter Property="Padding" Value="24" />
  <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="24" ShadowDepth="4" Color="{DynamicResource ThemeColorC88DA5}" Opacity="0.09" /></Setter.Value></Setter>
 </Style>
 <Style TargetType="Button">
  <Setter Property="Background" Value="{DynamicResource ThemeBrushFFF8FB}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="BorderBrush" Value="{DynamicResource ThemeBrushEDD2DD}" /><Setter Property="BorderThickness" Value="1" />
  <Setter Property="Padding" Value="15,11" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FontSize" Value="13" />
  <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" /></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThemeBrushD68CA8}" /></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.65" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Rose}" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Rose}" /><Setter Property="Foreground" Value="{DynamicResource ThemeBrushFFFFFF}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="14" /></Style>
 <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource ThemeBrush00FFFFFF}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
 <Style x:Key="ThemeToggle" TargetType="ToggleButton">
  <Setter Property="Width" Value="38" /><Setter Property="Height" Value="22" /><Setter Property="Cursor" Value="Hand" />
  <Setter Property="Background" Value="{DynamicResource ThemeBrushDEB7C8}" /><Setter Property="BorderBrush" Value="{DynamicResource ThemeBrushDEB7C8}" /><Setter Property="BorderThickness" Value="1" />
  <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="VerticalAlignment" Value="Center" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Border x:Name="Track" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
    <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource ThemeBrushFFFFFF}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0" />
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Rose}" /><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Rose}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeBrushD68CA8}" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ThemeBrush8D2850}" /><Setter TargetName="Track" Property="BorderThickness" Value="2" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="CaretBrush" Value="{DynamicResource Rose}" /><Setter Property="SelectionBrush" Value="{DynamicResource ThemeBrushEAA7C0}" /><Setter Property="SelectionOpacity" Value="0.45" />
  <Setter Property="Padding" Value="13,11" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="{DynamicResource ThemeBrushFFFCFC}" /><Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
   <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"><Grid>
    <ScrollViewer x:Name="PART_ContentHost" />
    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource ThemeBrushB49BA8}" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Visibility="Collapsed" />
   </Grid></Border>
   <ControlTemplate.Triggers>
    <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible" /></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ThemeBrushCF7397}" /><Setter TargetName="Field" Property="Background" Value="{DynamicResource ThemeBrushFFFFFF}" /></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="PasswordBox">
  <Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="CaretBrush" Value="{DynamicResource Rose}" /><Setter Property="Padding" Value="13,11" /><Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="Background" Value="{DynamicResource ThemeBrushFFFCFC}" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Field" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" /></Border>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource ThemeBrushCF7397}" /></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="CheckBox">
  <Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" Cursor="Hand">
   <Border x:Name="CheckBorder" Width="20" Height="20" CornerRadius="6" Background="{DynamicResource ThemeBrushFFF7FA}" BorderBrush="{DynamicResource ThemeBrushDEB7C8}" BorderThickness="1" Margin="0,0,9,0"><Path x:Name="CheckMark" Data="M 4,9 L 8,13 L 15,5" Stroke="{DynamicResource ThemeBrushFFFFFF}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" /></Border><ContentPresenter VerticalAlignment="Center" />
   </StackPanel><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Rose}" /><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Rose}" /><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource ThemeBrush8D2850}" /><Setter TargetName="CheckBorder" Property="BorderThickness" Value="2" /></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="13" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
 <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource ThemeBrush00FFFFFF}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="Padding" Value="0" /></Style>
 <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="Padding" Value="10,7" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="{DynamicResource ThemeBrush00FFFFFF}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeBrushFBEAF0}" /><Setter Property="Foreground" Value="{DynamicResource ThemeBrush9A3F63}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeBrushFFF0F5}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ScrollViewer"><Setter Property="local:AutoHideScrollbars.IsEnabled" Value="True" /></Style>
 <Style TargetType="ScrollBar">
  <Setter Property="Width" Value="9" /><Setter Property="Background" Value="{DynamicResource ThemeBrush00FFFFFF}" /><Setter Property="Opacity" Value="0" />
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
   <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource ThemeBrush00FFFFFF}" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
   <Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource ThemeBrushD9A5BA}" CornerRadius="4" Margin="2,1" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
   <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{DynamicResource ThemeBrush00FFFFFF}" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
  </Track></ControlTemplate></Setter.Value></Setter>
  <Style.Triggers>
   <Trigger Property="local:AutoHideScrollbars.IsActive" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
   <Trigger Property="IsMouseCaptureWithin" Value="True"><Setter Property="Opacity" Value="1" /></Trigger>
   <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="9" /></Trigger>
  </Style.Triggers>
 </Style>
</ResourceDictionary>
