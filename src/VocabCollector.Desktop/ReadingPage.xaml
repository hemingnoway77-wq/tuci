<UserControl x:Class="VocabCollector.Desktop.ReadingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:reading="clr-namespace:VocabCollector.Core.Reading;assembly=VocabCollector.Core">
 <Grid Margin="22,18,22,16">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="268" /></Grid.ColumnDefinitions>

  <Border Grid.Column="0" Style="{StaticResource SheetCard}" Padding="32,26,34,0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Style="{StaticResource Eyebrow}" Text="DAILY READING" />
     <TextBlock Style="{StaticResource PageTitle}" Text="每日阅读" FontSize="24" Margin="0,8,0,0" />
     <TextBlock Text="先读摘要，再打开原文。不需要配置 AI。" Style="{StaticResource HintText}" Margin="0,7,0,0" />
     <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,17,0,0" />
    </StackPanel>
    <Grid Grid.Row="1">
     <ScrollViewer x:Name="ReadingArticlesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
      <ItemsControl x:Name="ReadingArticlesList" ItemsSource="{Binding Articles}" Focusable="False" AlternationCount="3">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
          <StackPanel>
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
             <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource Ordinal}}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="0,0,11,0" />
             <TextBlock Margin="0,0,12,0">
              <TextBlock.Style>
               <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
                <Setter Property="Text" Value="通用泛读" />
                <Style.Triggers>
                 <DataTrigger Binding="{Binding Category}" Value="{x:Static reading:ReadingCategory.Technology}">
                  <Setter Property="Text" Value="技术阅读" />
                  <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                 </DataTrigger>
                </Style.Triggers>
               </Style>
              </TextBlock.Style>
             </TextBlock>
             <TextBlock Text="{Binding SourceName}" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding PublishedAt, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=发布日期未提供}" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
           </Grid>
           <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,8,0,0">
            <TextBlock.Style>
             <Style TargetType="TextBlock">
              <Setter Property="FontFamily" Value="{StaticResource ContentFont}" />
              <Setter Property="FontSize" Value="21" />
              <Setter Property="FontWeight" Value="Medium" />
              <Setter Property="Foreground" Value="{DynamicResource Ink}" />
              <Setter Property="LineHeight" Value="28" />
              <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
              <Style.Triggers>
               <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="LineHeight" Value="34" />
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </TextBlock.Style>
           </TextBlock>
           <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontFamily="{StaticResource UiFont}" FontSize="14" LineHeight="24" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource InkSecondary}" Margin="0,6,0,6" MaxWidth="660" HorizontalAlignment="Left" />
           <Button x:Name="OpenArticleButton" Style="{StaticResource LinkAction}" Click="OpenArticle_Click" Tag="{Binding Url}" AutomationProperties.Name="阅读原文">
            <StackPanel Orientation="Horizontal">
             <TextBlock Text="阅读原文" />
             <Path Data="M 2,10 L 10,2 M 4,2 L 10,2 L 10,8" Stroke="{DynamicResource Accent}" StrokeThickness="1.2" Width="9" Height="9" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
           </Button>
          </StackPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <StackPanel x:Name="ReadingEmptyState" VerticalAlignment="Center" Margin="0,0,0,32">
      <StackPanel.Style>
       <Style TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers><DataTrigger Binding="{Binding Articles.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
       </Style>
      </StackPanel.Style>
      <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Ink}">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Setter Property="Text" Value="还没有今日文章" />
         <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Text" Value="正在为今天准备阅读…" /></DataTrigger></Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
      <TextBlock Text="点击右侧「刷新文章」获取；网络不好时也可以在这里重试。" Style="{StaticResource HintText}" Margin="0,9,0,0" />
     </StackPanel>
    </Grid>
   </Grid>
  </Border>

  <Border Grid.Column="2" Style="{StaticResource SheetCard}" Padding="24,26,24,22">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Style="{StaticResource Eyebrow}" Text="TODAY" />
     <TextBlock Text="{Binding DayLabel}" Style="{StaticResource DateText}" Margin="0,9,0,0" TextWrapping="Wrap" />
     <Border Width="30" Height="1" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Margin="0,14,0,0" />
     <TextBlock Style="{StaticResource MetaText}" Text="今日配比" Margin="0,20,0,5" />
     <TextBlock Text="{Binding Composition}" FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
     <TextBlock Text="社会与环境泛读，搭配一篇技术阅读。先读摘要，再打开原文。" Style="{StaticResource HintText}" Margin="0,10,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="2">
     <Button x:Name="DailyReadingRefreshButton" Style="{StaticResource PrimaryAction}" Command="{Binding RefreshCommand}" Height="40" ToolTip="重新获取今日文章；网络恢复后可在这里重试">
      <StackPanel Orientation="Horizontal">
       <Path Data="M 13,4 A 5.2,5.2 0 1 0 13,11 M 10,4 L 13,4 L 13,1" Stroke="{DynamicResource AccentInk}" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
       <TextBlock Text="刷新文章" />
      </StackPanel>
     </Button>
     <Button x:Name="DailyReadingCancelButton" Content="取消获取" Command="{Binding CancelCommand}" Style="{StaticResource QuietAction}" Margin="0,4,0,0" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" />
     <TextBlock Text="免费获取 · 无需 API Key" Style="{StaticResource MetaCenter}" Margin="0,11,0,0" />
     <TextBlock Text="不调用模型 · 不写入词库" Style="{StaticResource MetaCenter}" Margin="0,4,0,0" />
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
