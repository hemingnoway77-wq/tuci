<UserControl x:Class="VocabCollector.Desktop.ReadingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:reading="clr-namespace:VocabCollector.Desktop.Reading" xmlns:core="clr-namespace:VocabCollector.Core.Reading;assembly=VocabCollector.Core" FocusVisualStyle="{x:Null}">
 <Border Style="{StaticResource SheetCard}" Margin="22,18,22,16" Padding="32,24,32,8">
  <Grid>
   <Grid x:Name="ReadingDirectory">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Style="{StaticResource Eyebrow}" Text="DAILY READING"/>
      <TextBlock Style="{StaticResource PageTitle}" Text="每日阅读" FontSize="24" Margin="0,7,0,0"/>
      <TextBlock Style="{StaticResource HintText}" Text="打开纯净全文，点选单词即可翻译或收录。" Margin="0,7,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
      <Button x:Name="DailyReadingRefreshButton" Content="刷新文章" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryAction}" Padding="19,10"/>
      <Button x:Name="DailyReadingCancelButton" Content="取消获取" Command="{Binding CancelCommand}" Style="{StaticResource QuietAction}" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
     <ScrollViewer x:Name="ReadingArticlesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}" Padding="0,0,8,0">
      <ItemsControl x:Name="ReadingArticlesList" ItemsSource="{Binding Articles}" Focusable="False" FocusVisualStyle="{x:Null}" AlternationCount="3">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0" Padding="0,18,0,18">
          <StackPanel>
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
             <TextBlock Margin="0,0,12,0" FontSize="13" Foreground="{DynamicResource InkSecondary}">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="通用泛读"/><Style.Triggers><DataTrigger Binding="{Binding Category}" Value="{x:Static core:ReadingCategory.Technology}"><Setter Property="Text" Value="技术阅读"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
             </TextBlock>
             <TextBlock Text="{Binding SourceName}" Style="{StaticResource MetaText}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding PublishedAt, StringFormat={}{0:yyyy-MM-dd}}" Style="{StaticResource MetaText}"/>
           </Grid>
           <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontFamily="{StaticResource ContentFont}" FontSize="25" LineHeight="34" Foreground="{DynamicResource Ink}" Margin="0,8,0,0" Cursor="Hand" MouseLeftButtonUp="ArticleTitle_Click"/>
           <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontFamily="{StaticResource UiFont}" FontSize="14" LineHeight="24" Foreground="{DynamicResource InkSecondary}" Margin="0,7,0,10"/>
           <Button x:Name="OpenArticleButton" Content="阅读全文 →" Style="{StaticResource LinkAction}" Click="OpenArticle_Click" AutomationProperties.Name="阅读纯净全文"/>
          </StackPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
     <StackPanel x:Name="ReadingEmptyState" VerticalAlignment="Center">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Articles.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="还没有今日文章" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="点击上方「刷新文章」获取；网络恢复后也可以在这里重试。" Style="{StaticResource HintText}" Margin="0,9,0,0"/>
     </StackPanel>
    </Grid>
   </Grid>

   <Grid x:Name="ArticleSurface" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="BackToReadingListButton" Content="← 返回每日阅读" Style="{StaticResource LinkAction}" Click="BackToReadingList_Click"/>
     <Button x:Name="ArticleSourceButton" Grid.Column="1" Content="来源网页 ↗" Style="{StaticResource QuietAction}" Click="ArticleSource_Click"/>
    </Grid>
    <StackPanel Grid.Row="1">
     <TextBlock x:Name="ArticleSourceText" Style="{StaticResource Eyebrow}"/>
     <TextBlock x:Name="ArticleTitleText" TextWrapping="Wrap" FontFamily="{StaticResource ContentFont}" FontSize="28" LineHeight="37" Foreground="{DynamicResource Ink}" Margin="0,8,0,0"/>
     <TextBlock x:Name="ArticleStatusText" Text="点选正文单词，可翻译或收录。" Style="{StaticResource HintText}" Margin="0,9,0,12" TextWrapping="Wrap"/>
     <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,0,0,8"/>
    </StackPanel>
    <Grid Grid.Row="2">
     <reading:ArticleTextReader x:Name="ArticleBodyReader" MaxWidth="950" HorizontalAlignment="Stretch"/>
     <StackPanel x:Name="ArticleLoadState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="660" Margin="0,0,0,28">
      <TextBlock x:Name="ArticleLoadMessage" Style="{StaticResource BodyText}" TextWrapping="Wrap" TextAlignment="Center"/>
      <Button x:Name="RetryArticleButton" Content="重试全文" Style="{StaticResource QuietAction}" Margin="0,12,0,0" Click="RetryArticle_Click"/>
     </StackPanel>
    </Grid>
    <Popup x:Name="ReadingWordPopup" PlacementTarget="{Binding ElementName=ArticleBodyReader}" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" Closed="ReadingWordPopup_Closed">
     <Border Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="16,12" MinWidth="220" MaxWidth="360">
      <StackPanel>
       <TextBlock x:Name="ReadingSelectedWord" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"/>
       <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
        <Button x:Name="ReadingTranslateButton" Content="翻译" Style="{StaticResource QuietAction}" Click="TranslateWord_Click" Margin="0,0,8,0"/>
        <Button x:Name="ReadingCaptureButton" Content="收录" Style="{StaticResource PrimaryAction}" Click="CaptureWord_Click" Padding="14,7"/>
       </StackPanel>
       <TextBlock x:Name="WordTranslationText" TextWrapping="Wrap" FontSize="14" LineHeight="23" Foreground="{DynamicResource InkSecondary}" Margin="0,9,0,0" Visibility="Collapsed"/>
      </StackPanel>
     </Border>
    </Popup>
   </Grid>
  </Grid>
 </Border>
</UserControl>
