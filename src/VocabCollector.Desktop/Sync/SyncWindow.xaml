<Window x:Class="VocabCollector.Desktop.SyncWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="账号与同步 · 兔词" Width="520" SizeToContent="Height" MaxHeight="850" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <TextBlock Text="账号与同步" Style="{StaticResource PageTitle}" FontSize="24" Margin="0,0,0,16"/>
  <StackPanel x:Name="ConnectPanel">
   <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UrlBox" Tag="https://sync.example.com" Margin="0,5,0,14"/>
   <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UsernameBox" Margin="0,5,0,14"/>
   <TextBlock Text="密码（注册时为 8–128 位）" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="PasswordBox" Margin="0,5,0,14"/>
   <TextBlock Text="本机单词目录" Style="{StaticResource FieldLabel}"/>
   <DockPanel Margin="0,5,0,10"><Button Content="选择…" DockPanel.Dock="Right" Click="Choose_Click" Style="{StaticResource OutlineAction}" Margin="6,0,0,0"/><TextBox x:Name="FolderBox"/></DockPanel>
   <TextBlock Text="Windows 和手机网页版登录同一账号，即可同步 Markdown、漫游学习记录、阅读位置和主题。不同账号请选择独立目录。API Key 仅保留在本机。" TextWrapping="Wrap" Style="{StaticResource HintText}" Margin="0,0,0,14"/>
   <WrapPanel><Button Content="登录并同步" Style="{StaticResource PrimaryAction}" Click="Login_Click" Margin="0,0,8,0"/><Button Content="注册账号" Style="{StaticResource OutlineAction}" Click="Register_Click"/></WrapPanel>
   <Expander Header="使用激活码或设备配对码" Margin="0,18,0,0"><StackPanel Margin="0,10,0,0"><PasswordBox x:Name="CodeBox" Margin="0,0,0,10"/><Button Content="配对并同步" Style="{StaticResource OutlineAction}" Click="Bind_Click"/></StackPanel></Expander>
  </StackPanel>
  <StackPanel x:Name="BoundPanel">
   <TextBlock x:Name="AccountLabel" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <TextBlock x:Name="Details" TextWrapping="Wrap" Style="{StaticResource HintText}" Margin="0,0,0,14"/>
   <WrapPanel><Button Content="立即同步" Style="{StaticResource OutlineAction}" Click="Sync_Click" Margin="0,0,6,0"/><Button x:Name="LogoutButton" Content="退出账号" Click="Logout_Click" Style="{StaticResource QuietAction}" Margin="6,0,0,0"/><Button x:Name="DisconnectButton" Content="断开本机" Click="Disconnect_Click" Style="{StaticResource QuietAction}" Margin="6,0,0,0" Visibility="Collapsed"/></WrapPanel>
   <TextBox x:Name="PairBox" AutomationProperties.Name="短期设备配对码" IsReadOnly="True" Visibility="Collapsed" Margin="0,8,0,0"/>
   <Expander x:Name="ChangePasswordPanel" Header="修改密码" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0">
    <TextBlock Text="当前密码" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="CurrentPasswordBox" Margin="0,5,0,10"/>
    <TextBlock Text="新密码（8–128 位）" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="NewPasswordBox" Margin="0,5,0,10"/>
    <Button Content="保存新密码" Style="{StaticResource OutlineAction}" Click="ChangePassword_Click"/>
   </StackPanel></Expander>
   <Expander x:Name="InvitePanel" Header="邀请码" Visibility="Collapsed" Expanded="Invite_Expanded" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0">
    <TextBlock Text="新用户需要邀请码才能创建账号。每个邀请码只能使用一次，7 天内有效。" TextWrapping="Wrap" Style="{StaticResource HintText}" Margin="0,0,0,10"/>
    <WrapPanel><Button Content="生成邀请码" Style="{StaticResource OutlineAction}" Click="Invite_Click" Margin="0,0,8,0"/><Button Content="刷新列表" Style="{StaticResource QuietAction}" Click="Invites_Click"/></WrapPanel>
    <TextBox x:Name="InviteCodeBox" IsReadOnly="True" Visibility="Collapsed" Margin="0,10,0,0" AutomationProperties.Name="新生成的邀请码"/>
    <TextBlock x:Name="InviteListText" TextWrapping="Wrap" Style="{StaticResource HintText}" Margin="0,10,0,0"/>
   </StackPanel></Expander>
   <Expander x:Name="ClaimPanel" Header="为当前配对词库注册账号" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0">
    <TextBlock Text="关联当前词库后，可用用户名和密码登录手机网页版。" TextWrapping="Wrap" Style="{StaticResource HintText}" Margin="0,0,0,10"/>
    <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ClaimUsernameBox" Margin="0,5,0,10"/>
    <TextBlock Text="密码（8–128 位）" Style="{StaticResource FieldLabel}"/><PasswordBox x:Name="ClaimPasswordBox" Margin="0,5,0,10"/>
    <Button Content="注册并关联当前词库" Style="{StaticResource OutlineAction}" Click="Claim_Click"/>
   </StackPanel></Expander>
  </StackPanel>
  <TextBlock x:Name="StatusText" TextWrapping="Wrap" Style="{StaticResource HintText}" Margin="0,14,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
