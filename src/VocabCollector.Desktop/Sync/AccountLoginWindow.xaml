<Window x:Class="VocabCollector.Desktop.AccountLoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="登录兔词" Width="720" MinWidth="620" MinHeight="450" SizeToContent="Height" MaxHeight="780"
 ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource Sheet}"
 Style="{StaticResource {x:Type Window}}">
 <Grid Background="{DynamicResource Sheet}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="37*"/><ColumnDefinition Width="63*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="28,28">
   <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
    <Image Source="/兔词;component/Assets/app-icon-256.png" Width="60" Height="60" HorizontalAlignment="Center"
           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
    <TextBlock Text="兔词" Style="{StaticResource PageTitle}" FontSize="40" HorizontalAlignment="Center" Margin="0,16,0,0"/>
   </StackPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
   <StackPanel MaxWidth="392" Margin="34,29,36,27">
    <TextBlock x:Name="ModeTitle" Text="登录账号" Style="{StaticResource PageTitle}" FontSize="25" Margin="0,0,0,16"/>
    <StackPanel x:Name="CredentialsPanel">
     <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/>
     <TextBox x:Name="UsernameBox" MaxLength="40" Margin="0,6,0,14" MinHeight="42" AutomationProperties.Name="用户名"/>
     <TextBlock x:Name="PasswordLabel" Text="密码" Style="{StaticResource FieldLabel}"/>
     <PasswordBox x:Name="PasswordBox" MaxLength="128" Margin="0,6,0,15" MinHeight="42" AutomationProperties.Name="密码"/>
     <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
      <TextBlock Text="确认密码" Style="{StaticResource FieldLabel}"/>
      <PasswordBox x:Name="ConfirmPasswordBox" MaxLength="128" Margin="0,6,0,14" MinHeight="42" AutomationProperties.Name="确认密码"/>
     </StackPanel>
     <StackPanel x:Name="InvitePanel" Visibility="Collapsed">
      <TextBlock Text="邀请码" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="InviteBox" MaxLength="32" Margin="0,6,0,6" MinHeight="42" CharacterCasing="Upper" AutomationProperties.Name="邀请码"/>
      <TextBlock Text="新账号需要管理员签发的邀请码，7 天内有效、仅可使用一次。" Style="{StaticResource HintText}" Margin="0,0,0,15"/>
     </StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="LoginButton" Content="登录" IsDefault="True" Style="{StaticResource PrimaryAction}" MinHeight="43" Click="Login_Click"/>
      <Button x:Name="RegisterButton" Grid.Column="2" Content="用邀请码注册" Style="{StaticResource OutlineAction}" MinHeight="43" Click="Register_Click"/>
     </Grid>
     <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0" Margin="0,17,0,0" Padding="0,10,0,0">
      <Expander x:Name="AdvancedOptions" Header="高级设置" IsExpanded="False" Foreground="{DynamicResource InkSecondary}">
       <StackPanel Margin="0,10,0,0">
        <TextBlock Text="同步服务地址" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="UrlBox" Margin="0,6,0,0" MinHeight="40" AutomationProperties.Name="同步服务地址"/>
       </StackPanel>
      </Expander>
     </Border>
    </StackPanel>
    <ProgressBar x:Name="BusyIndicator" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,14,0,0"/>
    <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}" Margin="0,11,0,0" Text="登录后，词库与学习记录会随账号同步。" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
