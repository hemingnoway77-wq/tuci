<UserControl x:Class="VocabCollector.Desktop.Learning.LearningPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:VocabCollector.Desktop.Learning"
 xmlns:controls="clr-namespace:VocabCollector.Desktop.Controls">
 <UserControl.Resources>
  <Style x:Key="RoamingMeter" TargetType="ProgressBar">
   <Setter Property="Background" Value="{DynamicResource LineSoft}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Grid x:Name="PART_Track" Background="Transparent" ClipToBounds="True">
     <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
     <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid x:Name="LibrarySurface"><local:LibraryBrowser x:Name="Browser"/></Grid>
  <Grid x:Name="RoamingSurface" Visibility="Hidden" Margin="22,18,22,16">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="RoamingCardColumn" Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition x:Name="RoamingStatusColumn" Width="272"/><ColumnDefinition x:Name="RoamingPreviewGap" Width="0"/><ColumnDefinition x:Name="RoamingPreviewColumn" Width="0"/></Grid.ColumnDefinitions>
   <Border x:Name="RoamingWordCard" Style="{DynamicResource SheetCard}" Padding="34,26,34,24">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="漫游复习" Style="{DynamicResource PageTitle}" FontSize="25"/>
      <Grid x:Name="RoamingModeSelector" Grid.Column="1" Height="34" VerticalAlignment="Center" Margin="6,0,0,0"
            KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained" SizeChanged="RoamingModeSelector_SizeChanged">
       <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
       <RadioButton x:Name="RoamingBrowseModeButton" GroupName="RoamingMode" Content="翻卡" FontSize="13" IsChecked="True"
                    Style="{DynamicResource NavTab}" AutomationProperties.Name="翻卡" Checked="PracticeMode_Changed" PreviewKeyDown="PracticeMode_KeyDown"/>
       <RadioButton x:Name="RoamingPracticeModeButton" Grid.Column="1" GroupName="RoamingMode" Content="作答" FontSize="13"
                    Style="{DynamicResource NavTab}" AutomationProperties.Name="作答" Checked="PracticeMode_Changed" PreviewKeyDown="PracticeMode_KeyDown"/>
       <controls:PageTabIndicator x:Name="RoamingModeUnderline" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,3" Opacity="0.55" SnapsToDevicePixels="True"/>
      </Grid>
     </Grid>
     <ScrollViewer x:Name="RoamingCardScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-32,24,-32,16">
      <StackPanel x:Name="RoamingCardBody" Margin="32,0,32,0">
      <StackPanel.RenderTransform><TranslateTransform x:Name="RoamingModeSlide"/></StackPanel.RenderTransform>
      <StackPanel x:Name="NormalRoamingBody">
       <TextBlock Text="{Binding RememberedLabel}" Margin="0,0,0,10" Foreground="{DynamicResource InkTertiary}">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Style.Triggers><DataTrigger Binding="{Binding RememberedLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
       <TextBlock x:Name="RoamingWordText" Text="{Binding RoamingTitle}" FontFamily="{DynamicResource ContentFont}" FontSize="38" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding RoamingPhonetics}" Style="{DynamicResource BodyText}" Margin="0,12,0,0"/>
       <Border Height="1" Background="{DynamicResource Line}" Margin="0,18,0,18"/>
       <local:HoldToReveal x:Name="RoamingMeaningReveal" Text="{Binding RoamingMeaning}" CanReveal="{Binding HasExposure}"/>
       <Button x:Name="RoamingReadNoteButton" Content="阅读整篇笔记 →" Click="RoamingRead_Click" Style="{DynamicResource LinkAction}" IsEnabled="{Binding HasExposure}" Margin="0,20,0,0"/>
      </StackPanel>
      <StackPanel x:Name="PracticePanel" Visibility="Collapsed">
       <TextBlock x:Name="PracticeKindText" Style="{DynamicResource MetaText}" Margin="0,0,0,14"/>
       <TextBlock x:Name="PracticePreparationText" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,18"/>
       <TextBlock x:Name="PracticePromptText" FontFamily="{DynamicResource ContentFont}" FontSize="25" LineHeight="36" Foreground="{DynamicResource Ink}" TextWrapping="Wrap"/>
       <TextBlock x:Name="PracticeContextText" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed"/>
       <TextBlock x:Name="PracticeMeaningHint" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,14,0,0"/>
       <TextBlock x:Name="PracticeLetterHint" Style="{DynamicResource MetaText}" Margin="0,10,0,0"/>
       <TextBox x:Name="PracticeAnswerBox" Margin="0,22,0,0" MinHeight="48" MaxHeight="108" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="19" MaxLength="2000" TextChanged="PracticeAnswer_Changed" PreviewKeyDown="PracticeAnswer_KeyDown" AutomationProperties.Name="复习答案"/>
       <TextBlock x:Name="PracticeTimerText" Style="{DynamicResource MetaText}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
       <StackPanel x:Name="PracticeResultPanel" Visibility="Collapsed" Margin="0,22,0,0">
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,17"/>
        <TextBlock x:Name="PracticeResultText" Foreground="{DynamicResource Accent}" FontSize="14" TextWrapping="Wrap"/>
        <TextBlock x:Name="PracticeCorrectWord" FontFamily="{DynamicResource ContentFont}" FontSize="30" Foreground="{DynamicResource Ink}" Margin="0,9,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="PracticeReferenceMeaning" Style="{DynamicResource BodyText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock x:Name="PracticeTranslationText" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,9,0,0"/>
        <TextBlock x:Name="PracticeFormText" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,9,0,0"/>
        <Button x:Name="PracticeReadNoteButton" Content="阅读整篇笔记 →" Click="RoamingRead_Click" Style="{DynamicResource LinkAction}" Margin="0,15,0,0"/>
       </StackPanel>
      </StackPanel>
      </StackPanel>
     </ScrollViewer>
     <UniformGrid x:Name="RoamingBrowseActions" Grid.Row="2" Columns="2">
      <Button x:Name="RoamingSkipButton" Content="下一张" Click="Skip_Click" Style="{DynamicResource OutlineAction}" IsEnabled="{Binding CanAdvance}" Margin="0,0,10,0" Height="46"/>
      <Button x:Name="RoamingRememberButton" Content="今天已记住" Click="Remember_Click" Style="{DynamicResource PrimaryAction}" IsEnabled="{Binding CanAdvance}" Height="46"/>
     </UniformGrid>
     <Grid x:Name="PracticeActions" Grid.Row="2" Visibility="Collapsed">
      <UniformGrid x:Name="PracticeInputActions" Columns="2">
       <Button x:Name="PracticeSkipButton" Content="想不起来" Click="PracticeSkip_Click" Style="{DynamicResource OutlineAction}" Margin="0,0,10,0" Height="46"/>
       <Button x:Name="PracticeSubmitButton" Content="提交" Click="PracticeSubmit_Click" Style="{DynamicResource PrimaryAction}" Height="46"/>
      </UniformGrid>
      <Button x:Name="PracticeNextButton" Content="下一张" Click="PracticeNext_Click" Style="{DynamicResource PrimaryAction}" Visibility="Collapsed" Height="46"/>
      <UniformGrid x:Name="PracticeSelfAssessmentActions" Columns="2" Visibility="Collapsed">
       <Button x:Name="PracticeNoButton" Content="不符合" Click="PracticeNo_Click" Style="{DynamicResource OutlineAction}" Margin="0,0,10,0" Height="46"/>
       <Button x:Name="PracticeYesButton" Content="符合" Click="PracticeYes_Click" Style="{DynamicResource PrimaryAction}" Height="46"/>
      </UniformGrid>
      <UniformGrid x:Name="PracticePreparationActions" Columns="2" Visibility="Collapsed">
       <Button x:Name="PracticeUnpreparedNextButton" Content="换一个词" Click="PracticeUnpreparedNext_Click" Style="{DynamicResource OutlineAction}" Margin="0,0,10,0" Height="46"/>
       <Button x:Name="PracticePrepareButton" Content="准备语境题" Click="PracticePrepare_Click" Style="{DynamicResource PrimaryAction}" Height="46"/>
      </UniformGrid>
     </Grid>
    </Grid>
   </Border>
   <Border x:Name="RoamingStatusPanel" Grid.Column="2" Style="{DynamicResource SheetCard}" Padding="22,26,22,20">
    <Grid x:Name="RoamingStatusBody" ClipToBounds="True" SizeChanged="RoamingStatusBody_SizeChanged">
     <StackPanel VerticalAlignment="Top">
     <TextBlock x:Name="RoamingStatusHeader" Text="漫游状态" FontFamily="{DynamicResource DisplayFont}" FontSize="21" Foreground="{DynamicResource Ink}" Margin="0,0,0,24"/>
     <StackPanel x:Name="RoamingWeightSection">
      <TextBlock Text="本次抽取倾向" Style="{DynamicResource FieldLabel}"/>
      <TextBlock Text="{Binding WeightDescription}" Style="{DynamicResource MetaText}" Margin="0,7,0,8"/>
      <ProgressBar x:Name="RoamingWeightBar" Style="{StaticResource RoamingMeter}" Value="{Binding WeightLevel, Mode=OneWay}" Maximum="1" Height="7" AutomationProperties.Name="本次抽取倾向"/>
     </StackPanel>
     <StackPanel x:Name="RoamingCoverageSection">
      <Border Height="1" Background="{DynamicResource Line}" Margin="0,22,0,20"/>
      <TextBlock Text="复习覆盖" Style="{DynamicResource FieldLabel}"/>
      <local:PeriodSelector x:Name="RoamingPeriodSelector" Margin="0,5,0,9" HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding CoverageLabel}" FontSize="20" Foreground="{DynamicResource Ink}" Margin="0,0,0,9"/>
      <ProgressBar x:Name="RoamingCoverageBar" Style="{StaticResource RoamingMeter}" Value="{Binding Coverage, Mode=OneWay}" Maximum="1" Height="7" AutomationProperties.Name="复习覆盖进度"/>
     </StackPanel>
     <StackPanel x:Name="RoamingActivitySection">
     <Border Height="1" Background="{DynamicResource Line}" Margin="0,22,0,20"/>
     <TextBlock Text="每日漫游" Style="{DynamicResource FieldLabel}" Margin="0,0,0,12"/>
     <ItemsControl x:Name="RoamingActivityGrid" ItemsSource="{Binding ActivityDays}" Focusable="False" FocusVisualStyle="{x:Null}" HorizontalAlignment="Left">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="7" Columns="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Width="11" Height="11" Margin="0,0,3,3" Background="{Binding Fill}" BorderBrush="{DynamicResource Line}" BorderThickness="0.5" CornerRadius="2" Opacity="{Binding Opacity}" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="100" AutomationProperties.Name="{Binding Tooltip}"/>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     </StackPanel>
    </StackPanel></Grid>
   </Border>
   <Border x:Name="RoamingPreviewPane" Grid.Column="4" Style="{DynamicResource SheetCard}" Visibility="Collapsed" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="15,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="笔记预览" Style="{DynamicResource Eyebrow}"/><TextBlock Text="{Binding RoamingPreviewTitle}" Foreground="{DynamicResource Ink}" FontSize="16" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel>
       <controls:PaneCloseButton xmlns:controls="clr-namespace:VocabCollector.Desktop.Controls" x:Name="CloseRoamingPreviewButton" Grid.Column="1" Click="CloseRoamingPreview_Click" VerticalAlignment="Top" AutomationProperties.Name="关闭笔记预览"/>
      </Grid>
     </Border>
     <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="12,3,12,0">
       <local:NotebookNavigationButton x:Name="RoamingPreviewBackButton" Kind="back" Label="后退" IsEnabled="{Binding CanPreviewGoBack}" Click="RoamingPreviewBack_Click"/>
       <local:NotebookNavigationButton x:Name="RoamingPreviewForwardButton" Kind="forward" Label="前进" IsEnabled="{Binding CanPreviewGoForward}" Click="RoamingPreviewForward_Click" Margin="4,0,0,0"/>
      </StackPanel>
      <local:NoteReader x:Name="RoamingPreviewReader" Grid.Row="1"/>
     </Grid>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
