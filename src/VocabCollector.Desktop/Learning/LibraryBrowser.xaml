<UserControl x:Class="VocabCollector.Desktop.Learning.LibraryBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VocabCollector.Desktop.Learning" FontFamily="{DynamicResource UiFont}" Foreground="{DynamicResource Ink}">
 <UserControl.Resources>
  <Style x:Key="BrowserKeyboardFocus" TargetType="Control">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
    <Border Height="28" VerticalAlignment="Top" Margin="3,0,3,0" BorderBrush="{DynamicResource InkTertiary}" BorderThickness="0,0,0,1" Opacity="0.55"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type local:LibraryTreeEntry}" ItemsSource="{Binding Children}">
   <Grid ToolTip="{Binding RelativePath}"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Path Width="13" Height="14" Stretch="Uniform" Stroke="{DynamicResource InkTertiary}" StrokeThickness="1.2" VerticalAlignment="Center">
     <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M3,1 L10,1 14,5 14,17 3,17 Z M10,1 L10,5 14,5"/><Style.Triggers><DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Data" Value="M1,4 L6,4 8,6 17,6 17,16 1,16 Z"/></DataTrigger></Style.Triggers></Style></Path.Style>
    </Path>
    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   </Grid>
  </HierarchicalDataTemplate>
  <Style x:Key="BrowserTreeItem" TargetType="TreeViewItem">
   <Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=TwoWay}"/><Setter Property="Foreground" Value="{DynamicResource InkSecondary}"/>
   <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource BrowserKeyboardFocus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
    <StackPanel>
     <Border x:Name="Row" Background="Transparent" CornerRadius="2" MinHeight="28" Padding="2,0,6,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="24" Focusable="False" Background="Transparent" BorderThickness="0">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path x:Name="Chevron" Data="M4,3 L8,7 4,11" Stroke="{DynamicResource InkTertiary}" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform></Path></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
       </ToggleButton>
       <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <ItemsPresenter x:Name="Children" Margin="15,0,0,0"/>
    </StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
     <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed"/></Trigger>
     <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding IsFolder}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="Row" Property="Background" Value="{DynamicResource Selection}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></MultiDataTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TreeViewItem" BasedOn="{StaticResource BrowserTreeItem}"/>
 </UserControl.Resources>
 <Grid x:Name="BrowserMotionHost" Margin="22,18,22,16" ClipToBounds="True">
 <Grid x:Name="BrowserLayout">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="FilesColumn" Width="270" MinWidth="0"/><ColumnDefinition x:Name="SplitterColumn" Width="16"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
  <Border x:Name="FileListPane" Style="{DynamicResource SheetCard}" Padding="16,16,12,14">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
     <local:NotebookNavigationButton x:Name="CollapseFilesButton" DockPanel.Dock="Right" Kind="panel-left" Label="收起文件列表" Click="CollapseFiles_Click"/>
     <TextBlock Text="我的词库" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
    </DockPanel>
    <TextBox x:Name="LibrarySearchBox" Grid.Row="1" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" Tag="搜索文件名或笔记正文" Margin="0,0,0,12" FontSize="13"/>
    <Grid Grid.Row="2">
     <TreeView x:Name="BrowserFilesTree" ItemsSource="{Binding Tree}" ItemContainerStyle="{StaticResource BrowserTreeItem}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItemChanged="Tree_Selected" TreeViewItem.Expanded="Tree_Expanded" TreeViewItem.Collapsed="Tree_Collapsed"/>
     <TextBlock x:Name="FilesEmptyText" Foreground="{DynamicResource InkTertiary}" TextWrapping="Wrap" Margin="4,10,4,0" VerticalAlignment="Top" IsHitTestVisible="False"/>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,12,2,0">
     <TextBlock x:Name="FileCountText" Style="{DynamicResource MetaText}" Margin="2,0,0,9"/>
     <UniformGrid Columns="2" Height="32"><Button x:Name="ImportMarkdownButton" Content="导入 Markdown" Click="Import_Click" Style="{DynamicResource OutlineAction}" Padding="5,7" FontSize="12" Margin="0,0,5,0"/><Button x:Name="ReloadLibraryButton" Content="刷新" Click="Reload_Click" Style="{DynamicResource QuietAction}" Padding="5,7"/></UniformGrid>
    </StackPanel>
   </Grid>
  </Border>
  <GridSplitter x:Name="BrowserSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" DragCompleted="Splitter_DragCompleted"><GridSplitter.Style><Style TargetType="GridSplitter"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Line}"/></Trigger></Style.Triggers></Style></GridSplitter.Style></GridSplitter>
  <Border x:Name="ReaderPane" Grid.Column="2" Style="{DynamicResource SheetCard}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="12,8">
     <DockPanel>
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0"><local:NotebookNavigationButton x:Name="ShowFilesButton" Kind="panel-left" Label="文件列表" Visibility="Collapsed" Click="ShowFiles_Click"/><local:NotebookNavigationButton x:Name="BrowserBackButton" Kind="back" Label="后退" IsEnabled="False" Click="Back_Click"/><local:NotebookNavigationButton x:Name="BrowserForwardButton" Kind="forward" Label="前进" IsEnabled="False" Click="Forward_Click"/></StackPanel>
      <TextBlock x:Name="DocumentPathText" Foreground="{DynamicResource InkTertiary}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
    <Grid Grid.Row="1">
     <local:NoteReader x:Name="ReadingSurface"/>
     <StackPanel x:Name="ReaderEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" MaxWidth="380" IsHitTestVisible="False"><TextBlock Text="选择一篇笔记" Foreground="{DynamicResource Ink}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="从左侧文件列表打开词条或 Markdown。关联词可以直接阅读，返回后继续原来的位置。" Foreground="{DynamicResource InkSecondary}" TextWrapping="Wrap" FontSize="14" LineHeight="24"/></StackPanel>
    </Grid>
   </Grid>
  </Border>
 </Grid>
 <Image x:Name="SidebarTransitionImage" Visibility="Collapsed" Stretch="Fill" IsHitTestVisible="False" Focusable="False"/>
 </Grid>
</UserControl>
