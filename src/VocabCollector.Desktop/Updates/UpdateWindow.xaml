<Window x:Class="VocabCollector.Desktop.Updates.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="软件更新 · 兔词" Width="560" Height="520" MinWidth="500" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="30,26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="UPDATES" Style="{StaticResource Eyebrow}"/>
   <TextBlock Text="软件更新" Style="{StaticResource PageTitle}" Margin="0,8,0,8"/>
   <TextBlock x:Name="VersionText" Style="{StaticResource MetaText}"/>
  </StackPanel>
  <Border Grid.Row="1" Style="{StaticResource SheetCard}" Padding="22,20" Margin="0,20,0,18">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="UpdateMessageText" TextWrapping="Wrap" Style="{StaticResource BodyText}"/>
    <TextBlock x:Name="PackageSizeText" Grid.Row="1" Style="{StaticResource MetaText}" Margin="0,10,0,12"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" Style="{StaticResource BodyText}"/></ScrollViewer>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
     <ProgressBar x:Name="DownloadProgress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed"/>
     <TextBlock x:Name="ProgressText" Style="{StaticResource MetaText}" Margin="0,7,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
   <Button x:Name="LaterButton" Content="稍后" Style="{StaticResource QuietAction}" Click="Later_Click" Margin="0,0,8,0"/>
   <Button x:Name="CancelUpdateButton" Content="取消下载" Style="{StaticResource OutlineAction}" Click="Cancel_Click" Margin="0,0,8,0" Visibility="Collapsed"/>
   <Button x:Name="CheckUpdateButton" Content="检查更新" Style="{StaticResource OutlineAction}" Click="Check_Click" Margin="0,0,8,0"/>
   <Button x:Name="InstallUpdateButton" Content="下载并重启更新" Style="{StaticResource PrimaryAction}" Click="Install_Click" Visibility="Collapsed"/>
  </WrapPanel>
 </Grid>
</Window>
