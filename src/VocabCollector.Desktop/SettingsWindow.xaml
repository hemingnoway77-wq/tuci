<Window x:Class="VocabCollector.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="设置 · 兔词" Width="680" Height="800" MinWidth="580" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="26,22,26,22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Margin="2,0,0,22"><TextBlock Text="你的学习空间" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="配置一次，以后遇见单词就能直接收录。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,0" /></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="24,22">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,4,0">
     <StackPanel Orientation="Horizontal" Margin="0,0,0,22"><Border Background="{DynamicResource ThemeBrushFBE8F0}" CornerRadius="8" Padding="8,5" Margin="0,0,10,0"><TextBlock Text="01" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Rose}" /></Border><TextBlock Text="连接 AI" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
     <TextBlock Text="API 地址" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BaseUrlBox" Tag="https://api.example.com/v1" />
     <TextBlock Text="支持 HTTP / HTTPS 和本地模型，填写服务商提供的 API 前缀。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,18" TextWrapping="Wrap" LineHeight="18" />
     <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" /><PasswordBox x:Name="KeyBox" />
     <TextBlock Text="仅在本机加密保存，不写入单词笔记。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,18" />
     <TextBlock Text="模型名称" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ModelBox" Tag="填写服务商提供的模型名" />
     <Border Height="1" Background="{DynamicResource Line}" Margin="0,25,0,22" />
     <StackPanel Orientation="Horizontal" Margin="0,0,0,22"><Border Background="{DynamicResource ThemeBrushFFF2CF}" CornerRadius="8" Padding="8,5" Margin="0,0,10,0"><TextBlock Text="02" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeBrush917544}" /></Border><TextBlock Text="安放词卡" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
     <TextBlock Text="Obsidian 仓库根目录" Style="{StaticResource FieldLabel}" />
     <DockPanel><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="选择文件夹" Click="Browse_Click" Margin="8,0,0,0" Padding="12,10" /><TextBox x:Name="VaultBox" Tag="选择你的 Obsidian 仓库" /></DockPanel>
     <TextBlock Text="单词目录会建立在这个仓库中。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,18" />
     <TextBlock Text="单词保存子目录" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SubfolderBox" Margin="0,0,0,19" Tag="例如 英语单词" />
     <CheckBox x:Name="ClassifyBox" Content="按主要词性分文件夹" />
     <TextBlock Text="一个单词一张词卡，多种词性保存在一起。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="29,8,0,2" LineHeight="18" />
    </StackPanel>
   </ScrollViewer>
  </Border>
  <StackPanel Grid.Row="2" Margin="0,17,0,0">
   <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ThemeBrushB33960}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Click="Cancel_Click" Style="{StaticResource QuietButton}" Margin="0,0,9,0" /><Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save_Click" Padding="23,12" /></StackPanel>
  </StackPanel>
 </Grid>
</Window>
