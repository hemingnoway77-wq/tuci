<Window x:Class="VocabCollector.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="设置 · 兔词" Width="900" Height="700" MinWidth="780" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <Grid Margin="26,22,26,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Margin="2,0,0,18">
   <TextBlock Style="{StaticResource Eyebrow}" Text="SETTINGS" />
   <TextBlock Style="{StaticResource PageTitle}" Text="设置" FontSize="24" Margin="0,8,0,0" />
   <TextBlock Text="AI 接口用于收录新词，本地阅读和复习无需配置接口。" Style="{StaticResource HintText}" Margin="0,7,0,0" />
  </StackPanel>

  <Border Grid.Row="1" Style="{StaticResource SheetCard}" Padding="28,24,26,22">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,2,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

     <StackPanel Grid.Column="0" Margin="0,0,28,0">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
       <TextBlock Text="01" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
       <TextBlock Text="连接 AI" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
      </StackPanel>
      <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,0,0,18" />

      <TextBlock Text="API 地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
      <TextBox x:Name="BaseUrlBox" Tag="https://api.example.com/v1" />
      <TextBlock Text="支持 HTTP / HTTPS 和本地模型，填写服务商提供的 API 前缀。" Style="{StaticResource HintText}" Margin="0,6,0,16" />

      <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
      <PasswordBox x:Name="KeyBox" />
      <TextBlock Text="仅在本机加密保存，不写入单词笔记。" Style="{StaticResource HintText}" Margin="0,6,0,16" />

      <TextBlock Text="模型名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
      <TextBox x:Name="ModelBox" Tag="填写服务商提供的模型名" />
     </StackPanel>

     <Border Grid.Column="1" Background="{DynamicResource LineSoft}" Margin="0,2,0,2" />

     <StackPanel Grid.Column="2" Margin="28,0,0,0">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
       <TextBlock Text="02" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
       <TextBlock Text="安放词卡" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" />
      </StackPanel>
      <Border Height="1" Background="{DynamicResource LineSoft}" Margin="0,0,0,18" />

      <TextBlock Text="本地词库位置" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
      <DockPanel>
       <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="选择文件夹" Click="Browse_Click" Style="{StaticResource OutlineAction}" Margin="8,0,0,0" />
       <TextBox x:Name="VaultBox" Tag="默认由兔词管理，也可选择已有词库" />
      </DockPanel>
      <TextBlock Text="笔记保存在本机，可在兔词内阅读和复习。已有 Markdown 词库可继续使用。" Style="{StaticResource HintText}" Margin="0,6,0,16" />

      <TextBlock Text="单词保存子目录" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
      <TextBox x:Name="SubfolderBox" Tag="例如 英语单词" Margin="0,0,0,18" />

      <CheckBox x:Name="ClassifyBox" Content="按主要词性分文件夹" />
      <TextBlock Text="一个单词一张词卡，多种词性保存在一起。" Style="{StaticResource HintText}" Margin="27,7,0,0" />
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </Border>

  <StackPanel Grid.Row="2" Margin="0,14,0,0">
   <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,0,0,10" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="取消" Click="Cancel_Click" Style="{StaticResource QuietAction}" Margin="0,0,8,0" />
    <Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryAction}" Click="Save_Click" Padding="22,11" />
   </StackPanel>
  </StackPanel>
 </Grid>
</Window>
