<Window x:Class="VocabCollector.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:VocabCollector.Desktop.Controls"
 xmlns:local="clr-namespace:VocabCollector.Desktop"
 Title="设置 · 兔词" Width="900" Height="700" MinWidth="780" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
 <Window.Resources>
  <Style x:Key="SettingsCategoryTab" TargetType="RadioButton">
   <Setter Property="Height" Value="42" />
   <Setter Property="FontSize" Value="14" />
   <Setter Property="Foreground" Value="{DynamicResource InkSecondary}" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusVisual}" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border Background="{TemplateBinding Background}" Padding="12,0" CornerRadius="2">
       <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
      </Border>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <Trigger Property="IsChecked" Value="True">
     <Setter Property="Foreground" Value="{DynamicResource Ink}" />
     <Setter Property="FontWeight" Value="Medium" />
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True">
     <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
     <Setter Property="Opacity" Value="0.45" />
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="SettingsCategoryPage" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
   <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
   <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
   <Setter Property="Focusable" Value="False" />
  </Style>
  <Style x:Key="SettingsPageBody" TargetType="StackPanel">
   <Setter Property="Margin" Value="30,24,30,22" />
  </Style>
 </Window.Resources>
 <Grid Margin="26,22,26,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <TextBlock Style="{StaticResource PageTitle}" Text="设置" FontSize="24" Margin="2,0,0,16" />

  <Border Grid.Row="1" Style="{StaticResource SheetCard}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="168" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" CornerRadius="2,0,0,2">
     <Grid x:Name="CategoryNavigation" Margin="13,18,12,18" VerticalAlignment="Top"
           AutomationProperties.Name="设置分类" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
      <StackPanel Margin="7,0,0,0">
       <RadioButton x:Name="AccountTab" GroupName="SettingsCategories" Style="{StaticResource SettingsCategoryTab}" Content="账号与同步" IsChecked="True" />
       <RadioButton x:Name="LibraryTab" GroupName="SettingsCategories" Style="{StaticResource SettingsCategoryTab}" Content="本地词库" />
       <RadioButton x:Name="ApiTab" GroupName="SettingsCategories" Style="{StaticResource SettingsCategoryTab}" Content="AI 接口" />
       <RadioButton x:Name="UpdateTab" GroupName="SettingsCategories" Style="{StaticResource SettingsCategoryTab}" AutomationProperties.Name="应用更新">
        <Grid>
         <TextBlock Text="应用更新" />
         <Ellipse x:Name="UpdateCategoryDot" Width="7" Height="7" Fill="{DynamicResource UpdateNotification}" Visibility="Collapsed"
                  HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
       </RadioButton>
      </StackPanel>
      <controls:PageTabIndicator x:Name="CategoryIndicator" Orientation="Vertical" Width="1" Height="Auto"
                                 HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="3,0,0,0" />
     </Grid>
    </Border>
    <Grid x:Name="CategoryPages" Grid.Column="1">
     <ScrollViewer x:Name="AccountPage" Style="{StaticResource SettingsCategoryPage}">
      <StackPanel Style="{StaticResource SettingsPageBody}">
       <TextBlock Text="账号与同步" Style="{StaticResource PageTitle}" Margin="0,0,0,19" />
       <local:AccountSyncView x:Name="AccountSyncPanel" />
      </StackPanel>
     </ScrollViewer>

     <ScrollViewer x:Name="LibraryPage" Style="{StaticResource SettingsCategoryPage}" Visibility="Collapsed">
      <StackPanel Style="{StaticResource SettingsPageBody}">
       <TextBlock Text="本地词库" Style="{StaticResource PageTitle}" Margin="0,0,0,19" />
       <TextBlock Text="本地词库位置" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
       <DockPanel x:Name="VaultPathRow">
        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="选择文件夹" Click="Browse_Click" Style="{StaticResource OutlineAction}" Margin="8,0,0,0" />
        <TextBox x:Name="VaultBox" Tag="默认由兔词管理，也可选择已有词库" />
       </DockPanel>
       <TextBlock Text="笔记保存在本机，可在兔词内阅读和复习。已有 Markdown 词库可继续使用。" Style="{StaticResource HintText}" Margin="0,6,0,16" />
       <TextBlock Text="单词保存子目录" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
       <TextBox x:Name="SubfolderBox" Tag="例如 英语单词" Margin="0,0,0,18" />
       <CheckBox x:Name="ClassifyBox" Content="按主要词性分文件夹" />
       <TextBlock Text="一个单词一张词卡，多种词性保存在一起。" Style="{StaticResource HintText}" Margin="27,7,0,0" />
      </StackPanel>
     </ScrollViewer>

     <ScrollViewer x:Name="ApiPage" Style="{StaticResource SettingsCategoryPage}" Visibility="Collapsed">
      <StackPanel Style="{StaticResource SettingsPageBody}">
       <TextBlock Text="AI 接口" Style="{StaticResource PageTitle}" Margin="0,0,0,19" />
       <TextBlock Text="API 地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
       <TextBox x:Name="BaseUrlBox" Tag="https://api.example.com/v1" />
       <TextBlock Text="用于收录新词和生成语境题，支持本地模型。" Style="{StaticResource HintText}" Margin="0,6,0,16" />
       <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
       <PasswordBox x:Name="KeyBox" />
       <TextBlock Text="仅在本机加密保存，不写入单词笔记。" Style="{StaticResource HintText}" Margin="0,6,0,16" />
       <TextBlock Text="模型名称" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
       <TextBox x:Name="ModelBox" Tag="填写服务商提供的模型名" />
      </StackPanel>
     </ScrollViewer>

     <ScrollViewer x:Name="UpdatePage" Style="{StaticResource SettingsCategoryPage}" Visibility="Collapsed">
      <StackPanel Style="{StaticResource SettingsPageBody}">
       <TextBlock Text="应用更新" Style="{StaticResource PageTitle}" Margin="0,0,0,19" />
       <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,1" Padding="0,13">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
         <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock x:Name="CurrentVersionText" Text="更新检查当前不可用" Style="{StaticResource BodyText}" />
          <TextBlock x:Name="UpdateAvailableText" Text="有新版本可用" Style="{StaticResource MetaText}" Visibility="Collapsed" Margin="0,3,0,0" />
         </StackPanel>
         <Button x:Name="CheckUpdateButton" Grid.Column="1" Click="CheckUpdate_Click" IsEnabled="False"
                 Style="{StaticResource OutlineAction}" VerticalAlignment="Center" AutomationProperties.Name="检查更新">
          <Grid>
           <TextBlock Text="检查更新" />
           <Ellipse x:Name="CheckUpdateDot" Width="7" Height="7" Fill="{DynamicResource UpdateNotification}" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-6,0" IsHitTestVisible="False" />
          </Grid>
         </Button>
        </Grid>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Border>

  <StackPanel Grid.Row="2" Margin="0,14,0,0">
   <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,0,0,10" Visibility="Collapsed" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Style="{StaticResource QuietAction}" Margin="0,0,8,0" />
    <Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryAction}" Click="Save_Click" Padding="22,11" />
   </StackPanel>
  </StackPanel>
 </Grid>
</Window>
