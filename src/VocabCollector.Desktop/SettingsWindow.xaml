<Window x:Class="VocabCollector.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 单词收集器" Width="660" Height="700" MinWidth="580" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="设置你的词库" FontSize="24" FontWeight="Bold" /><TextBlock Text="配置一次，以后遇见单词就能直接收录。" Foreground="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="API 地址" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BaseUrlBox" />
        <TextBlock Text="支持 HTTP / HTTPS，例如 http://localhost:11434/v1，使用服务商提供的 API 前缀。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,16" TextWrapping="Wrap" />
        <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" /><PasswordBox x:Name="KeyBox" />
        <TextBlock Text="仅在本机加密保存，不写入单词笔记。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,16" />
        <TextBlock Text="模型名" Style="{StaticResource FieldLabel}" /><TextBox x:Name="ModelBox" Margin="0,0,0,20" />
        <TextBlock Text="Obsidian 仓库根目录" Style="{StaticResource FieldLabel}" />
        <DockPanel><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="选择文件夹" Click="Browse_Click" Margin="8,0,0,0" Padding="12,8" /><TextBox x:Name="VaultBox" /></DockPanel>
        <TextBlock Text="选择整个仓库的文件夹；下面的单词目录会建在它里面。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,16" />
        <TextBlock Text="单词保存子目录" Style="{StaticResource FieldLabel}" /><TextBox x:Name="SubfolderBox" Margin="0,0,0,16" />
        <CheckBox x:Name="ClassifyBox" Content="按主要词性分文件夹" Margin="0,0,0,8" />
        <TextBlock Text="多种词性仍保存在同一份笔记里，重复词不会移动或覆盖。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Click="Cancel_Click" Margin="0,0,10,0" />
        <Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
